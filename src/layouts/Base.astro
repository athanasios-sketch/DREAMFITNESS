---
import '../styles/app.css';
const { title = 'DREAMFITNESS' } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#10131A" />
    <meta name="description" content="90-day body recomposition tracker: daily logging, scoring and trend analysis." />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- iOS ignores SVG for home-screen icons; it needs a PNG at this rel. -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <!-- the label that appears under the icon on the home screen -->
    <meta name="apple-mobile-web-app-title" content="DREAMFIT" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  </head>
  <body class="min-h-dvh"><slot /></body>
</html>
